---
import Layout from "../../layouts/Layout.astro";
import db from "../../lib/db";
const rows = db.prepare("SELECT id, code, name, level, description FROM formations ORDER BY name").all();
---
<Layout title="Formations">
  <h1>Formations</h1>
  <table>
    <thead>
      <tr>
        <th>Code</th>
        <th>Nom de la formation</th>
        <th>Niveau</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(f => 
        <tr>
          <td>{f.code}</td>
          <td>{f.name}</td>
          <td>{f.level}</td>
          <td>{f.description}</td>
        </tr>
      )}
    </tbody>
  </table>
</Layout>